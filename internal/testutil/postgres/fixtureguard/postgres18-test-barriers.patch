--- /dev/null
+++ b/src/include/tcop/fixtureguard.h
@@ -0,0 +1,33 @@
+/* Private server ABI for the isolated B3 qualification fixture only. */
+#ifndef B3_FIXTURE_GUARD_H
+#define B3_FIXTURE_GUARD_H
+
+#include "nodes/pg_list.h"
+#include "utils/relcache.h"
+
+typedef enum B3SequenceStep
+{
+	B3_SEQUENCE_ENTRY,
+	B3_SEQUENCE_PROVENANCE,
+	B3_SEQUENCE_EFFECT,
+	B3_SEQUENCE_DONE
+} B3SequenceStep;
+
+typedef struct B3FixtureHooks
+{
+	void (*backend)(void);
+	void (*message)(int type);
+	void (*copy_message)(int type, const char *data, size_t len);
+	void (*sql)(const char *query, bool extended, int params, const Oid *types);
+	void (*parsed)(const char *query, List *statements);
+	void (*deferred)(Oid table, Oid trigger);
+	void (*queued)(Oid table, Oid trigger);
+	void (*commit)(bool before_decision);
+	void (*allocate)(Oid sequence, Oid table, int32 attnum, bool serial, B3SequenceStep step);
+	void (*setval)(Oid sequence, Relation rel, int64 value, bool called, B3SequenceStep step);
+	void (*sequence_ddl)(Relation rel, bool ownership_only);
+} B3FixtureHooks;
+
+extern PGDLLIMPORT B3FixtureHooks *B3Fixture;
+
+#endif
